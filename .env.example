# ===== OBRIGATÓRIO =====
ANTHROPIC_API_KEY=cole_sua_chave_aqui

# ===== PERSONALIZAÇÃO =====
JARVIS_NOME=Eduardo
JARVIS_CIDADE=Joinville
JARVIS_PALAVRA=jarvis

# Modelo: claude-sonnet-5-5 (mais esperto) ou claude-haiku-5-5 (mais rápido)
JARVIS_MODELO=claude-sonnet-5-5

# ===== VOZ (python -m jarvis --vozes para ver todas) =====
JARVIS_VOZ=pt-BR-AntonioNeural
JARVIS_VELOCIDADE=+8%
JARVIS_TOM=-4Hz

# ===== MICROFONE =====
# Número do microfone (python -m jarvis --dispositivos). Vazio = padrão.
JARVIS_MIC=
# Menor = mais sensível (2.0 a 5.0)
JARVIS_SENSIBILIDADE=3.0
# Silêncio (ms) que indica "terminei de falar"
JARVIS_SILENCIO_MS=900
# Segundos ouvindo sem precisar dizer "Jarvis" após uma resposta
JARVIS_JANELA_CONVERSA=8

# ===== EXTRAS =====
JARVIS_BUSCA_WEB=true
